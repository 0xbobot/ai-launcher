      "capabilities": [
        {
          "deeplink": "amap://route?sourceApplication=ai-launcher&dlat={lat}&dlon={lon}&dev=0&t=1",
          "fallbackToLauncher": true,
          "icon": "directions_subway",
          "id": "ditie",
          "label": "地铁",
          "note": "三家深链均以坐标直达（腾讯 routeplan 官方格式 tocoord）；没装地图时退 geo 坐标点；需真机验证",
          "packageNames": [
            "com.autonavi.minimap",
            "com.tencent.map",
            "com.baidu.BaiduMap"
          ],
          "providers": [
            {
              "name": "高德地图",
              "packageNames": [
                "com.autonavi.minimap"
              ],
              "deeplink": "amap://route?sourceApplication=ai-launcher&dlat={lat}&dlon={lon}&dev=0&t=1"
            },
            {
              "name": "腾讯地图",
              "packageNames": [
                "com.tencent.map"
              ],
              "deeplink": "qqmap://map/routeplan?type=bus&tocoord={lat},{lon}&referer=ai-launcher"
            },
            {
              "name": "百度地图",
              "packageNames": [
                "com.baidu.BaiduMap"
              ],
              "deeplink": "baidumap://map/direction?destination=latlng:{lat},{lon}&mode=transit&coord_type=gcj02&src=ai-launcher"
            }
          ],
          "geoFallback": "coord",
          "params": [
            {
              "name": "lat",
              "label": "目的地纬度",
              "required": true,
              "ask": "目的地纬度是多少？"
            },
            {
              "name": "lon",
              "label": "目的地经度",
              "required": true,
              "ask": "目的地经度是多少？"
            }
          ]
        },
        {
          "id": "daohang",
          "label": "导航",
          "icon": "navigation",
          "packageNames": [
            "com.autonavi.minimap",
            "com.baidu.BaiduMap",
            "com.tencent.map"
          ],
          "deeplink": "amap://route?sourceApplication=ai-launcher&dname={to}&dev=0&t=1",
          "providers": [
            {
              "name": "高德地图",
              "packageNames": [
                "com.autonavi.minimap"
              ],
              "deeplink": "amap://route?sourceApplication=ai-launcher&dname={to}&dev=0&t=1"
            },
            {
              "name": "百度地图",
              "packageNames": [
                "com.baidu.BaiduMap"
              ],
              "deeplink": "baidumap://map/direction?destination={to}&mode=driving&src=ai-launcher"
            },
            {
              "name": "腾讯地图",
              "packageNames": [
                "com.tencent.map"
              ],
              "deeplink": null
