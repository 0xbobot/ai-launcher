<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OTA 检查更新 / 下载安装包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- OTA 安装 APK：Android 8+ 安装未知应用 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 通知渠道（API 33+，桌面自身发通知时用） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 日历：首页「今日日程」卡片 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 录音：意图框语音输入 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 取全量应用列表：个人侧载应用，无上架政策顾虑；launcher 必备（Android 11+ 包可见性过滤） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 用量统计：设置 > 特殊应用权限 中手动开启 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="AI桌面"
        android:supportsRtl="true"
        android:theme="@style/Theme.AILauncher">

        <!-- 同时是 LAUNCHER（应用列表可见）和 HOME（可设为默认桌面） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 通知监听："正在进行时"信息流的数据来源，需用户在设置中手动开启 -->
        <service
            android:name=".service.LauncherNotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- OTA 安装：FileProvider 把下载好的 APK 授权给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
