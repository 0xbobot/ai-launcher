<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OTA 检查更新 / 下载安装包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- OTA 安装 APK：Android 8+ 安装未知应用 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 通知渠道（API 33+，桌面自身发通知时用） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 低电量守护：前台服务保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 低电量提醒：全屏温和弹窗（来电同款机制，Android 14+ 需声明） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- v0.41.14：低电强制打断——悬浮窗权限，后台直接启动全屏提醒（用户去设置开一次） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 日历：首页「今日日程」卡片 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 智能卡片（第十一批）：预约卡“帮我建提醒”——在系统日历里建提醒事件。
         与读分开授权（READ_CALENDAR 不等于能写），只在用户点“帮我建提醒”时
         先说明再弹系统框。Play 版上架前须与 READ_SMS / READ_CONTACTS 一起评估，
         本声明只走测试版 / OTA 渠道。 -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 智能卡片（447）：消息连接器主路径——直接读短信（设备上显示为“读取消息”），
         只读近期短信、只解析账单/预约类。Play 版注意：Google Play 规定只有默认短信
         处理程序才能声明 READ_SMS，启动器不是默认短信应用——Play 版上架的同时
         必须去掉本声明（改走通知通道兜底），本声明只走测试版 / OTA 渠道。 -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- 智能卡片（447）：联系人连接器——只按号码查姓名（未接来电显示成名字）。
         同为敏感权限：Play 版上架前须复核是否保留（2026 年 4 月联系人政策收紧方向）。 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- v0.68.12：盲操诊断浮层状态变化短震动（50ms，普通权限安装即授） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 取全量应用列表：个人侧载应用，无上架政策顾虑；launcher 必备（Android 11+ 包可见性过滤） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 用量统计：设置 > 特殊应用权限 中手动开启 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="AI桌面"
        android:supportsRtl="true"
        android:theme="@style/Theme.AILauncher">

        <!-- 同时是 LAUNCHER（应用列表可见）和 HOME（可设为默认桌面） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- v0.32.3：长按图标快捷方式 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 系统面板服务：首屏下滑手势打开通知中心/控制中心，需用户在无障碍设置中手动开启 -->
        <service
            android:name=".service.PanelAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/panel_accessibility_service" />
        </service>

        <!-- 通知监听："正在进行时"信息流的数据来源，需用户在设置中手动开启 -->
        <service
            android:name=".service.LauncherNotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 角标广播探针（Bob 2026-11-08 凌晨：实测，不要只推理）：只收不发。
             ShortcutBadger 发广播前用 queryBroadcastReceivers 找接收方，
             只找得到 manifest 里声明的 receiver；exported=true 才能收到
             别的应用发的广播。收到后只记数，不触发任何操作。 -->
        <receiver
            android:name=".data.BadgeBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BADGE_COUNT_UPDATE" />
                <action android:name="me.leolin.shortcutbadger.BADGE_COUNT_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- v0.40.0：低电量守护前台服务已删除（常驻通知打扰），改为 LauncherApp 里
             跟随进程生命周期的动态广播监听 -->

        <!-- v0.68.27：低电量悬浮窗服务（替代 BatteryGuardActivity 弹窗，不拽回桌面） -->
        <service
            android:name=".ui.battery.BatteryOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="低电量悬浮窗提醒" />
        </service>

        <!-- 低电量提醒弹窗：半透明主题，居中温和卡片。
             v0.36.1：全屏 intent 必须能盖住视频/游戏等全屏应用
             v0.68.27：已废弃，改走 BatteryOverlayService 悬浮窗（保留 activity 供降级） -->
        <activity
            android:name=".ui.battery.BatteryGuardActivity"
            android:exported="false"
            android:theme="@style/Theme.AILauncher.BatteryGuard"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- OTA 安装：FileProvider 把下载好的 APK 授权给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
